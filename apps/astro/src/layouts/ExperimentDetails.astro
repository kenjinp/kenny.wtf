---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import LinkButton from "@components/LinkButton.astro";

export interface Props {
  experiment: CollectionEntry<"experiments">;
}

const { experiment } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  heroImage,
  heroImageAlt,
  tags,
  pubDatetime,
} = experiment.data;

const { Content } = await experiment.render();

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? SITE.ogImage ?? "og.png",
  Astro.url.origin,
).href;
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogUrl}
  canonicalURL={canonicalURL}
>
  <Header />
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mb-2 mt-8 flex hover:opacity-75"
      onclick="history.back()"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>Go back</span>
    </button>
  </div>
  <main id="main-content">
    <h1 class="post-title">{title}</h1>
    <Datetime datetime={pubDatetime} label="Published:" className="my-2" />
    {
      heroImage && (
        <img
          class="mt-4 h-64 w-full object-cover object-center"
          src={heroImage as string}
          alt={heroImageAlt ?? `Preview image for ${title}`}
        />
      )
    }

    <article
      id="article"
      role="article"
      class="prose mx-auto mt-8 mb-8 max-w-3xl"
    >
      <Content />
    </article>

    <h3>
      Follow the{" "}
      <LinkButton href={`/tags/${experiment.slug}`}>
        #{experiment.slug}
      </LinkButton>{" "}
      tag to read more related content!
    </h3>

    <ul class="tags-container">
      {tags.map((tag: string) => <Tag name={slugifyStr(tag)} />)}
    </ul>
  </main>
  <Footer />
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  .post-title {
    @apply text-2xl font-semibold text-skin-accent;
  }
  .tags-container {
    @apply my-8;
  }
</style>
